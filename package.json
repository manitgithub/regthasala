{
  "name": "examops",
  "private": true,
  "scripts": {
    "build": "node scripts/copy-fonts.mjs && npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i resources/app.css -o web/css/app.css --minify",
    "build:js": "esbuild resources/app.js --bundle --minify --outfile=web/js/app.js",
    "test:e2e": "node tests/browser.mjs",
    "test:admission": "node tests/admission-browser.mjs",
    "test:schedule": "node tests/schedule-browser.mjs",
    "test:admin-ux": "node tests/admin-ux.mjs",
    "test:operations": "php tests/operations-domain.php && node tests/operations-browser.mjs",
    "test:address": "node tests/thai-address-browser.mjs"
  },
  "dependencies": {"@fontsource/noto-sans-thai": "^5.2.0", "lucide": "^0.468.0"},
  "devDependencies": {"@tailwindcss/cli": "^4.0.0", "tailwindcss": "^4.0.0", "esbuild": "^0.25.0", "@playwright/test": "^1.56.0"}
}
